# Copy to .env and replace with your real Groq key.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model must be available on your Groq account. If unset, the service
# auto-discovers one. List yours: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
# Request timeout in seconds (must stay below the Spring Boot read timeout)
GROQ_TIMEOUT=300